DEVICE_PATH := device/samsung/a02

# For building with minimal manifest
ALLOW_MISSING_DEPENDENCIES := true

# Architecture (64-bit only, kernel + userspace arm64)
TARGET_ARCH := arm64
TARGET_ARCH_VARIANT := armv8-a
TARGET_CPU_ABI := arm64-v8a
TARGET_CPU_ABI2 :=
TARGET_CPU_VARIANT := cortex-a53
TARGET_CPU_VARIANT_RUNTIME := cortex-a53
TARGET_IS_64_BIT := true

BOARD_VENDOR := samsung
TARGET_SOC := k39tv1_bsp_titan_hamster
TARGET_BOOTLOADER_BOARD_NAME := k39tv1_bsp_titan_hamster
TARGET_BOARD_PLATFORM := mt6739
TARGET_BOARD_PLATFORM_GPU := powervr

TARGET_USES_64_BIT_BINDER := true

# Kernel (arm64 Image.gz, text_offset 0x80000 -> loaded at base + kernel_offset)
# Kalau boot.img 64-bit yang udah jalan beda offset, ganti di sini aja.
A02_KERNEL_OFFSET := 0x00080000
A02_RAMDISK_OFFSET := 0x05000000
A02_TAGS_OFFSET := 0x04000000
A02_DTB_OFFSET := 0x04000000

BOARD_KERNEL_BASE := 0x40000000
BOARD_KERNEL_PAGESIZE := 2048
TARGET_PREBUILT_KERNEL := $(DEVICE_PATH)/prebuilt/Image
BOARD_KERNEL_CMDLINE := bootopt=64S3,32N2,64N2 androidboot.hardware=mt6739
BOARD_BOOT_HEADER_VERSION := 2
BOARD_MKBOOTIMG_ARGS := --kernel_offset $(A02_KERNEL_OFFSET) --ramdisk_offset $(A02_RAMDISK_OFFSET) --tags_offset $(A02_TAGS_OFFSET) --dtb $(DEVICE_PATH)/prebuilt/dtb/dtb.dtb --dtb_offset $(A02_DTB_OFFSET) --board SRPTK19C003

# Partitions
BOARD_FLASH_BLOCK_SIZE := 131072
BOARD_BOOTIMAGE_PARTITION_SIZE := 25165824
BOARD_RECOVERYIMAGE_PARTITION_SIZE := 25165824
BOARD_HAS_LARGE_FILESYSTEM := true
BOARD_SYSTEMIMAGE_PARTITION_TYPE := ext4
BOARD_USERDATAIMAGE_FILE_SYSTEM_TYPE := f2fs
BOARD_VENDORIMAGE_FILE_SYSTEM_TYPE := ext4
TARGET_COPY_OUT_VENDOR := vendor

# Dynamic Partitions
BOARD_SAMSUNG_DYNAMIC_PARTITIONS_PARTITION_LIST := system vendor product odm
BOARD_SAMSUNG_DYNAMIC_PARTITIONS_SIZE := 4068474880

# Recovery
BOARD_INCLUDE_RECOVERY_DTBO := true
BOARD_PREBUILT_DTBOIMAGE := $(DEVICE_PATH)/prebuilt/dtbo
TARGET_USERIMAGES_USE_EXT4 := true

# Security patch level
VENDOR_SECURITY_PATCH := 2021-08-01

# Verified Boot
BOARD_AVB_ENABLE := false

# --- ORANGEFOX CONFIGURATIONS ---
# FOX_VERSION / FOX_BUILD_TYPE di-set dari workflow (env).
TARGET_DEVICE_ALT := a02,SM-A022F,a022
FOX_USE_TWRP_RECOVERY_IMAGE_BUILDER := 1
FOX_RECOVERY_BOOT_PARTITION := /dev/block/platform/bootdevice/by-name/recovery
FOX_RECOVERY_INSTALL_PARTITION := /dev/block/platform/bootdevice/by-name/recovery

# Diet buat partisi recovery 24MB (kernel udah ~10MB)
FOX_DELETE_AROMAFM := 1
FOX_DELETE_INITD_ADDON := 1
FOX_REMOVE_AAPT := 1
FOX_DISABLE_APP_MANAGER := 1
OF_NO_SPLASH_CHANGE := 1
OF_FLASHLIGHT_ENABLE := 0
OF_DISABLE_MIUI_SPECIFIC_FEATURES := 1

# Kompresi & Display
BOARD_RAMDISK_USE_LZMA := false
#LZMA_RAMDISK_TARGETS := recovery
TARGET_SCREEN_WIDTH := 720
TARGET_SCREEN_HEIGHT := 1600
TARGET_RECOVERY_PIXEL_FORMAT := "RGBX_8888"
OF_SCREEN_H := 2310

# TWRP & Storage Flags
RECOVERY_SDCARD_ON_DATA := true
TW_THEME := portrait_hdpi
TW_BRIGHTNESS_PATH := "/sys/class/backlight/panel/brightness"
TW_MAX_BRIGHTNESS := 255
TW_DEFAULT_BRIGHTNESS := 100
TW_Y_OFFSET := 60
TW_H_OFFSET := -60
TW_EXCLUDE_TZDATA := true
TW_EXCLUDE_LPDUMP := true
TW_HAS_DOWNLOAD_MODE := true
TW_EXCLUDE_DEFAULT_USB_INIT := true
TW_INTERNAL_STORAGE_PATH := "/data/media/0"
TW_INTERNAL_STORAGE_MOUNT_POINT := "data"
TW_EXTERNAL_STORAGE_PATH := "/external_sd"
TW_EXTERNAL_STORAGE_MOUNT_POINT := "external_sd"
TW_NO_LEGACY_PROPS := true
TW_NO_BIND_SYSTEM := true
#TW_INCLUDE_CRYPTO := true
#TW_INCLUDE_CRYPTO_FBE := true
#TW_INCLUDE_FBE_METADATA_DECRYPT := true
TW_EXCLUDE_APEX := true
TW_EXCLUDE_PYTHON := true
TW_EXCLUDE_NANO := true
TW_EXCLUDE_TWRPAPP := true
#BOARD_USES_METADATA_ENCRYPTION := true
TW_INPUT_BLACKLIST := "hbtp_vm"
TW_SUPPORT_INPUT_1_2 := true
TW_FILTER_TOUCH_EVENTS := true
TW_EVENT_LOGGING := false
BOARD_ROOT_EXTRA_FOLDERS := efs metadata omr optics prism
